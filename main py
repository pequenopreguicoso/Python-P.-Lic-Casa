"""GameBot — Python 3.10+
Comandos: !quiz e !ajuda. Não compartilhe seu token.
"""

import asyncio
import getpass
import os
import random

import discord
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents, help_command=None,
                   case_insensitive=True,
                   allowed_mentions=discord.AllowedMentions.none())

APRESENTACAO = (
    "**Olá! Eu sou o GameBot!**\n"
    "Faço mini quizzes sobre jogos para testar seus conhecimentos.\n"
    "» **!quiz** — inicia 5 perguntas aleatórias.\n"
    "» Responda com **A, B ou C** em até 20 segundos por pergunta.\n"
    "» Cada acerto vale 1 ponto. No final, mostro seu resultado.\n"
    "» Digite **sair** durante sua partida para parar.\n"
    "» **!ajuda** — mostra esta apresentação."
)


# Pergunta, alternativas e letra correta.
PERGUNTAS = [
    ("Qual personagem é conhecido como o encanador da Nintendo?",
     ["A) Sonic", "B) Mario", "C) Kirby"], "B"),
    ("Qual criatura de Minecraft explode perto do jogador?",
     ["A) Creeper", "B) Vaca", "C) Aldeão"], "A"),
    ("Qual é o nome do herói jogável de The Legend of Zelda: Ocarina of Time?",
     ["A) Ganondorf", "B) Zelda", "C) Link"], "C"),
    ("Qual destes Pokémon é do tipo Elétrico?",
     ["A) Charmander", "B) Pikachu", "C) Squirtle"], "B"),
    ("Em Among Us, quem sabota a nave e elimina tripulantes?",
     ["A) O impostor", "B) O fantasma tripulante", "C) O engenheiro tripulante"], "A"),
    ("Qual jogo combina futebol com carros?",
     ["A) The Sims", "B) Tetris", "C) Rocket League"], "C"),
    ("Qual personagem da Sega é famoso por correr muito rápido?",
     ["A) Bowser", "B) Sonic", "C) Donkey Kong"], "B"),
    ("Em qual jogo clássico você encaixa peças que caem para completar linhas?",
     ["A) Tetris", "B) Pac-Man", "C) Street Fighter II"], "A"),
    ("Qual destes jogos é uma simulação de vida?",
     ["A) Counter-Strike", "B) Doom", "C) The Sims"], "C"),
    ("Qual destes jogos tem Ryu e Chun-Li como lutadores?",
     ["A) Mortal Kombat", "B) Street Fighter", "C) Tekken"], "B"),
]

partidas = set()


@bot.event
async def on_ready():
    print('GameBot ligado como {}. Digite !quiz no Discord.'.format(bot.user))


@bot.event
async def on_guild_join(guild):
    # Prefere o canal de sistema; tenta outros se não puder enviar nele.
    canais = list(guild.text_channels)
    if guild.system_channel:
        canais.insert(0, guild.system_channel)
    if guild.me is None:
        return
    for canal in dict.fromkeys(canais):
        permissao = canal.permissions_for(guild.me)
        if permissao.view_channel and permissao.send_messages:
            try:
                await canal.send(APRESENTACAO)
                return
            except discord.HTTPException:
                continue
    print('Não consegui me apresentar em {}: verifique as permissões.'.format(guild.name))


@bot.command()
async def ajuda(ctx):
    await ctx.send(APRESENTACAO)


@bot.command()
async def quiz(ctx):
    chave = (ctx.channel.id, ctx.author.id)
    if chave in partidas:
        await ctx.send("Você já tem um quiz neste canal. Responda ou digite sair.")
        return

    partidas.add(chave)
    pontos = 0
    try:
        await ctx.send('**Quiz de {}**\n5 perguntas | 20 segundos cada | Responda A, B ou C.\nSomente suas respostas contam nesta partida. Digite sair para parar.'.format(ctx.author.display_name))
        for numero, (pergunta, alternativas, correta) in enumerate(
                random.sample(PERGUNTAS, 5), start=1):
            await ctx.send('**{} — Pergunta {}/5**\n'.format(ctx.author.display_name, numero)
                           + pergunta + "\n" + "\n".join(alternativas))

            def conferir(mensagem):
                return (mensagem.author.id == ctx.author.id
                        and mensagem.channel.id == ctx.channel.id
                        and mensagem.content.strip().upper() in {"A", "B", "C", "SAIR"})

            try:
                resposta = await bot.wait_for("message", check=conferir, timeout=20)
            except asyncio.TimeoutError:
                await ctx.send('Tempo esgotado! Resposta correta: **{}**.'.format(correta))
                continue

            letra = resposta.content.strip().upper()
            if letra == "SAIR":
                await ctx.send('Quiz encerrado. Você fez **{} ponto(s)**.'.format(pontos))
                return
            if letra == correta:
                pontos += 1
                await ctx.send("✓ Acertou! +1 ponto.")
            else:
                await ctx.send('× Não foi dessa vez. Resposta correta: **{}**.'.format(correta))

        await ctx.send('**{}, quiz concluído!**\nPontuação: **{}/5**. Digite **!quiz** para jogar novamente.'.format(ctx.author.display_name, pontos))
    finally:
        partidas.discard(chave)


@bot.event
async def on_command_error(ctx, error):
    if isinstance(error, commands.CommandNotFound):
        return
    print('Erro no comando: {}'.format(error))
    try:
        await ctx.send("Não consegui concluir o comando. Tente novamente com !quiz.")
    except discord.HTTPException:
        pass


